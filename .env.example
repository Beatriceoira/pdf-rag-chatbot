# OpenAI Configuration
OPENAI_API_KEY=

# Qdrant Configuration
QDRANT_MODE=local
QDRANT_URL=
QDRANT_API_KEY=

# Collection
COLLECTION_NAME=pdf_documents

# Embedding Provider
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_SEPARATORS="[\n\n]\n[\n]"

# Retrieval
RETRIEVAL_K=5

# Reranking
ENABLE_RERANKING=false
RERANK_TOP_K=3

# Logging
LOG_LEVEL=INFO

# File Limits
MAX_FILE_SIZE_MB=50
